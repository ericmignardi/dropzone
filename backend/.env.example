# Docker Run Command (PostgreSQL Container)
# docker run -d --name dropzone-db -e POSTGRES_USER=dropzone-user -e POSTGRES_PASSWORD=dropzone-password -e POSTGRES_DB=dropzone -p 5432:5432 -v dropzone-pgdata:/var/lib/postgresql/data postgres:16-alpine

# Database
DATABASE_URL="prisma+postgres://dropzone:dropzone123@localhost:5432/dropzone"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Server
PORT=3000
FRONTEND_URL="http://localhost:5173"
